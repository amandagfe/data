# Copie apenas os nomes para o gerenciador de segredos do ambiente de publicação.
# Não grave o token real neste arquivo nem em outro arquivo versionado.
TELEGRAM_ALERTS_ENABLED=1
TELEGRAM_BOT_TOKEN=SUBSTITUA_NO_AMBIENTE_DO_SERVIDOR
TELEGRAM_CHAT_ID=SUBSTITUA_NO_AMBIENTE_DO_SERVIDOR
# Produção: origens HTTPS separadas por vírgula. Em branco, o servidor exige mesma origem.
TELEGRAM_ALLOWED_ORIGINS=https://exemplo.org
